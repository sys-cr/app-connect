{
    "name": "studapp/app-connect",
    "description": "Connects the mobile apps to a Stud.IP instance.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "opis/json-schema": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "AppConnect\\": "lib/classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppConnect\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
